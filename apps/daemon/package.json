{
  "name": "@cursorremote/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cursorremote-daemon": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "login": "node dist/login.js",
    "probe": "node scripts/probe.mjs",
    "logout": "node -e \"import('@cursor/sdk').then(m=>m.Cursor.auth.logout()).then(()=>console.log('Signed out.'))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.36",
    "@cursorremote/protocol": "*",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
